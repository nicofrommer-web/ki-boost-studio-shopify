<header class="site-header">
  <div class="announcement">{{ section.settings.announcement }}</div>
  <div class="container site-header__inner">
    <a href="{{ routes.root_url }}" class="site-header__logo" aria-label="AURELE Startseite">
      {% if settings.logo != blank %}
        {{ settings.logo | image_url: width: 400 | image_tag: width: settings.logo_width, loading: 'eager', alt: shop.name }}
      {% else %}
        <span class="aurele-wordmark">AURELE</span>
      {% endif %}
    </a>
    <nav aria-label="Hauptnavigation">
      <ul class="site-nav">
        {% for block in section.blocks %}
          <li {{ block.shopify_attributes }}><a class="site-nav__link" href="{{ block.settings.url }}">{{ block.settings.label }}</a></li>
        {% endfor %}
      </ul>
    </nav>
    <div class="site-header__actions">
      <a class="cart-link" href="{{ routes.cart_url }}" aria-label="Warenkorb mit {{ cart.item_count }} Artikeln">Warenkorb <span class="cart-count">{{ cart.item_count }}</span></a>
      <button type="button" class="mobile-nav-toggle" data-mobile-nav-toggle aria-expanded="false" aria-controls="MobileNav" aria-label="Menü öffnen">{% render 'icon-menu' %}</button>
    </div>
  </div>
  <div id="MobileNav" class="mobile-nav" data-mobile-nav hidden>
    <ul class="mobile-nav__list">
      {% for block in section.blocks %}<li><a href="{{ block.settings.url }}">{{ block.settings.label }}</a></li>{% endfor %}
      <li><a href="{{ routes.cart_url }}">Warenkorb ({{ cart.item_count }})</a></li>
    </ul>
  </div>
</header>

{% schema %}
{
  "name": "AURELE Header",
  "settings": [
    { "type": "text", "id": "announcement", "label": "Hinweisleiste", "default": "Kostenloser Versand ab [BETRAG] · 14 Tage Rückgaberecht" }
  ],
  "blocks": [
    { "type": "link", "name": "Navigationslink", "settings": [
      { "type": "text", "id": "label", "label": "Linktext", "default": "Kollektion" },
      { "type": "url", "id": "url", "label": "Link" }
    ] }
  ],
  "default": { "blocks": [
    { "type": "link", "settings": { "label": "Shop", "url": "/collections/all" } },
    { "type": "link", "settings": { "label": "Größenhilfe", "url": "/pages/groessenhilfe" } },
    { "type": "link", "settings": { "label": "Über AURELE", "url": "/pages/ueber-uns" } },
    { "type": "link", "settings": { "label": "FAQ", "url": "/pages/faq" } }
  ] }
}
{% endschema %}
