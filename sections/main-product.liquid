<section class="section-padding product-page">
  <div class="container main-product">
    <div class="product-gallery">
      {% for image in product.images %}
        {{ image | image_url: width: 1200 | image_tag: class: 'product-gallery__image', loading: 'lazy', widths: '480, 720, 960, 1200', alt: image.alt | default: product.title }}
      {% else %}
        {{ 'product-1' | placeholder_svg_tag: 'product-gallery__image placeholder-svg' }}
      {% endfor %}
    </div>
    <div class="product-info">
      <p class="eyebrow">AURELE · Move through your day.</p>
      <h1 class="heading-xl">{{ product.title }}</h1>
      <div class="product-price">
        <span>{{ product.selected_or_first_available_variant.price | money }}</span>
        {% if product.selected_or_first_available_variant.compare_at_price > product.selected_or_first_available_variant.price %}
          <s>{{ product.selected_or_first_available_variant.compare_at_price | money }}</s>
        {% endif %}
      </div>
      <div class="product-description">{{ product.description }}</div>
      {% form 'product', product, class: 'product-form' %}
        {% unless product.has_only_default_variant %}
          <label for="Variant-{{ section.id }}">Größe / Farbe</label>
          <select id="Variant-{{ section.id }}" name="id" class="product-select">
            {% for variant in product.variants %}
              <option value="{{ variant.id }}" {% if variant == product.selected_or_first_available_variant %}selected{% endif %} {% unless variant.available %}disabled{% endunless %}>{{ variant.title }}{% unless variant.available %} – Ausverkauft{% endunless %} · {{ variant.price | money }}</option>
            {% endfor %}
          </select>
        {% else %}
          <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
        {% endunless %}
        <label for="Quantity-{{ section.id }}">Menge</label>
        <input class="product-quantity" type="number" id="Quantity-{{ section.id }}" name="quantity" value="1" min="1">
        <button type="submit" class="button button--primary button--block" {% unless product.selected_or_first_available_variant.available %}disabled{% endunless %}>{% if product.selected_or_first_available_variant.available %}In den Warenkorb{% else %}Ausverkauft{% endif %}</button>
        {{ form | payment_button }}
      {% endform %}
      <ul class="product-promises">
        <li>✓ Sichere Zahlung über Shopify</li>
        <li>✓ Versandzeit: [ECHTE LIEFERZEIT EINTRAGEN]</li>
        <li>✓ 14 Tage Rückgaberecht</li>
      </ul>
      <details><summary>Passform & Größen</summary><div>{{ section.settings.fit_text }}</div></details>
      <details><summary>Material & Pflege</summary><div>{{ section.settings.care_text }}</div></details>
      <details><summary>Versand & Rückgabe</summary><div>{{ section.settings.shipping_text }}</div></details>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "AURELE Produkt",
  "settings": [
    { "type": "richtext", "id": "fit_text", "label": "Passform", "default": "<p>[PASSFORM UND GRÖSSENEMPFEHLUNG EINTRAGEN]</p>" },
    { "type": "richtext", "id": "care_text", "label": "Material und Pflege", "default": "<p>[ECHTE MATERIALZUSAMMENSETZUNG UND PFLEGEHINWEISE EINTRAGEN]</p>" },
    { "type": "richtext", "id": "shipping_text", "label": "Versand und Rückgabe", "default": "<p>Lieferzeit: [LIEFERZEIT]. Rückgabe innerhalb von 14 Tagen. Details findest du auf unserer Seite Versand & Rückgabe.</p>" }
  ]
}
{% endschema %}
