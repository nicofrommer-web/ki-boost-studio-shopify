<footer class="site-footer">
  <div class="container footer__grid">
    <div><p class="aurele-wordmark aurele-wordmark--light">AURELE</p><p class="footer-copy">{{ section.settings.about_text }}</p></div>
    <div><p class="footer__col-title">Shop</p><ul class="footer__links">
      <li><a href="{{ routes.all_products_collection_url }}">Alle Produkte</a></li>
      <li><a href="/pages/groessenhilfe">Größenhilfe</a></li>
      <li><a href="/pages/versand-rueckgabe">Versand & Rückgabe</a></li>
      <li><a href="/pages/faq">FAQ</a></li>
    </ul></div>
    <div><p class="footer__col-title">Rechtliches</p><ul class="footer__links">
      <li><a href="/pages/impressum">Impressum</a></li><li><a href="/pages/datenschutz">Datenschutz</a></li>
      <li><a href="/pages/agb">AGB</a></li><li><a href="/pages/widerrufsbelehrung">Widerruf</a></li>
    </ul></div>
    <div><p class="footer__col-title">Kontakt</p><ul class="footer__links">
      <li><a href="mailto:{{ settings.contact_email }}">{{ settings.contact_email }}</a></li>
      <li>{{ settings.contact_address }}</li>
      {% if settings.social_instagram != blank %}<li><a href="{{ settings.social_instagram }}" target="_blank" rel="noopener">Instagram</a></li>{% endif %}
    </ul></div>
  </div>
  <div class="container footer__bottom"><p>© {{ 'now' | date: '%Y' }} AURELE. Alle Rechte vorbehalten.</p></div>
</footer>

{% schema %}
{
  "name": "AURELE Footer",
  "settings": [
    { "type": "textarea", "id": "about_text", "label": "Kurzbeschreibung", "default": "Minimalistische Athleisure für Pilates, Alltag und alles dazwischen. Move through your day." }
  ]
}
{% endschema %}
